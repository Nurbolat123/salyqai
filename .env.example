SALYQ_DATABASE_URL=postgresql+psycopg://salyq:salyq@localhost:5432/salyq
SALYQ_REDIS_URL=redis://localhost:6379/0
# base64 от 32 случайных байт: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
SALYQ_FIELD_KEY=
SALYQ_HMAC_KEY=
SALYQ_ENVIRONMENT=dev
# dev — заглушка без криптографии (запрещена при SALYQ_ENVIRONMENT=prod); ncanode — настоящая проверка
SALYQ_ECP_VERIFIER=dev
# SALYQ_NCANODE_URL=http://localhost:14579
# Локальная модель (vLLM) в ЦОДе РК; не задано — разметка правилами, чат без LLM
# SALYQ_LLM_BASE_URL=http://localhost:8001/v1
# SALYQ_LLM_MODEL=qwen2.5-14b-instruct
# Внешняя модель для чата — только zero data retention
# SALYQ_EXTERNAL_LLM_BASE_URL=
# SALYQ_EXTERNAL_LLM_MODEL=
# SALYQ_EXTERNAL_LLM_API_KEY=
# SALYQ_SMTP_HOST=
# SALYQ_TELEGRAM_BOT_TOKEN=
# SALYQ_SENTRY_DSN=
SALYQ_CORS_ORIGINS=["http://localhost:3000"]
